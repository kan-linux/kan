int \fBprocps_sigmask_names\fP (char *const \fIstr\fP, size_t \fIstorlek\fP , const char *\fIsigmask\fP);
int \fBprocps_capmask_names\fP (char *const \fIstr\fP, size_t \fIstorlek\fP,  const char *\fIfmgmask\fP);
