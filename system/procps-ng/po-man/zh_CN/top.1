.SH "10. 参见"
.\" ----------------------------------------------------------------------
\fBfree\fP(1), \fBps\fP(1), \fBuptime\fP(1), \fBatop\fP(1), \fBslabtop\fP(1), \fBvmstat\fP(8),
\fBw\fP(1)
