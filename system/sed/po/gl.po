"                 (para portabilidade use POSIX -E).\n"

#: sed/sed.c:165
#, c-format
msgid ""
"  -s, --separate\n"
"                 consider files as separate rather than as a single,\n"
"                 continuous long stream.\n"
msgstr ""
"  -s, --separate\n"
"                 trata os ficheiros coma separados máis que como unha "
"simple\n"
"                 longa tira de caracteres continua.\n"

#: sed/sed.c:168
#, c-format
msgid ""
"      --sandbox\n"
