"                 anota a execução do programa\n"

#: sed/sed.c:142
#, c-format
msgid ""
"  -e script, --expression=script\n"
"                 add the script to the commands to be executed\n"
msgstr ""
"  -e script, --expression=script\n"
"                 adiciona script aos comandos a executar\n"

#: sed/sed.c:144
#, c-format
msgid ""
"  -f script-file, --file=script-file\n"
