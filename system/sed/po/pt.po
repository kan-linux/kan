msgstr ""
"  -f script, --file=script\n"
"                 adiciona conteúdos de script aos comandos a executar\n"

#: sed/sed.c:148
#, c-format
msgid ""
"  --follow-symlinks\n"
"                 follow symlinks when processing in place\n"
msgstr ""
"  --follow-symlinks\n"
"                 segue ligações simbólicas ao processar no local\n"

#: sed/sed.c:151
#, c-format
msgid ""
"  -i[SUFFIX], --in-place[=SUFFIX]\n"
