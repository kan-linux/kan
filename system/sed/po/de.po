msgstr "Einklinken in %s nicht möglich: %s"

#: sed/utils.c:212
#, c-format
msgid "failed to set binary mode on '%s'"
msgstr "Binärmodus für »%s« konnte nicht gesetzt werden"

#: sed/utils.c:233
