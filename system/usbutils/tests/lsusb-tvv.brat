#!/bin/sh
# SPDX-FileCopyrightText: 2026 Greg Kroah-Hartman <gregkh@linuxfoundation.org>
#
# SPDX-License-Identifier: GPL-2.0-only
#
# lsusb -t gates extra per-device lines on verblevel >= 1 (ID line),
# >= 2 (sysfs / devnode path), >= 3 (Manufacturer/Product/Serial).

setup() {
	: "${LSUSB_BUILT:=$DIR/../build/lsusb}"
	: "${LSUSB_INSTALLED:=$(command -v lsusb || true)}"
}

@test "lsusb -tvv: built and installed output is identical" {
	[ -n "$LSUSB_INSTALLED" ]
	"$LSUSB_BUILT"     -tvv > "$TEST_TMP.built"     2>&1
	"$LSUSB_INSTALLED" -tvv > "$TEST_TMP.installed" 2>&1
	diff -u "$TEST_TMP.installed" "$TEST_TMP.built"
}

@test "lsusb -tvvv: built and installed output is identical" {
	[ -n "$LSUSB_INSTALLED" ]
	"$LSUSB_BUILT"     -tvvv > "$TEST_TMP.built"     2>&1
	"$LSUSB_INSTALLED" -tvvv > "$TEST_TMP.installed" 2>&1
	diff -u "$TEST_TMP.installed" "$TEST_TMP.built"
}

@test "lsusb -t --verbose --verbose: matches -tvv" {
	"$LSUSB_BUILT" -tvv                   > "$TEST_TMP.short" 2>&1
	"$LSUSB_BUILT" -t --verbose --verbose > "$TEST_TMP.long"  2>&1
	diff -u "$TEST_TMP.short" "$TEST_TMP.long"
}
