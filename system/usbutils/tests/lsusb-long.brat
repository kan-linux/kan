# SPDX-FileCopyrightText: 2026 Greg Kroah-Hartman <gregkh@linuxfoundation.org>
#
# SPDX-License-Identifier: GPL-2.0-only
#
# Long-option equivalence for the options that have one.  --tree and
# --help are covered in lsusb-t.brat / lsusb-h.brat.

setup() {
	: "${LSUSB_BUILT:=$DIR/../build/lsusb}"
}

@test "lsusb --verbose: matches -v" {
	"$LSUSB_BUILT" -v        > "$TEST_TMP.short" 2>&1
	"$LSUSB_BUILT" --verbose > "$TEST_TMP.long"  2>&1
	diff -u "$TEST_TMP.short" "$TEST_TMP.long"
}

@test "lsusb --version: matches -V" {
	"$LSUSB_BUILT" -V        > "$TEST_TMP.short" 2>&1
	"$LSUSB_BUILT" --version > "$TEST_TMP.long"  2>&1
	diff -u "$TEST_TMP.short" "$TEST_TMP.long"
}
