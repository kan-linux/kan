#!/bin/sh
# SPDX-FileCopyrightText: 2026 Greg Kroah-Hartman <gregkh@linuxfoundation.org>
#
# SPDX-License-Identifier: GPL-2.0-only
#
# -h sets help=1 and lets the getopt loop finish, then prints usage.
# Exit is 0 only if no option error was also seen (help && !err).

setup() {
	: "${LSUSB_BUILT:=$DIR/../build/lsusb}"
	: "${LSUSB_INSTALLED:=$(command -v lsusb || true)}"
}

@test "lsusb -h -t: -t parsed but unused, exit 0" {
	run "$LSUSB_BUILT" -h -t
	[ $status -eq 0 ]
	match "$stderr" '/Usage: lsusb/'
}

@test "lsusb -v -h -s : -d : -D /x: all parsed, -h wins, exit 0" {
	run "$LSUSB_BUILT" -v -h -s : -d : -D /x
	[ $status -eq 0 ]
	match "$stderr" '/Usage: lsusb/'
}

@test "lsusb -h -d nocolon: help with option error, exit 1" {
	run "$LSUSB_BUILT" -h -d nocolon
	[ $status -ne 0 ]
	match "$stderr" '/Usage: lsusb/'
}

@test "lsusb -h with options: built and installed output is identical" {
	[ -n "$LSUSB_INSTALLED" ]
	"$LSUSB_BUILT"     -v -h -t -s : -d : -D /x > "$TEST_TMP.built"     2>&1
	"$LSUSB_INSTALLED" -v -h -t -s : -d : -D /x > "$TEST_TMP.installed" 2>&1
	diff -u "$TEST_TMP.installed" "$TEST_TMP.built"
}
