# SPDX-License-Identifier: GPL-2.0-only
#
# verblevel > 1 only changes whether the do_dualspeed()/do_debug() EAGAIN
# error is suppressed; both binaries should agree either way.

setup() {
	: "${LSUSB_BUILT:=$DIR/../build/lsusb}"
	: "${LSUSB_INSTALLED:=$(command -v lsusb || true)}"
}

@test "lsusb -vv: built and installed output is identical" {
	[ -n "$LSUSB_INSTALLED" ]
	"$LSUSB_BUILT"     -vv > "$TEST_TMP.built"     2> /dev/null
	"$LSUSB_INSTALLED" -vv > "$TEST_TMP.installed" 2> /dev/null
	diff -u "$TEST_TMP.installed" "$TEST_TMP.built"
}

@test "lsusb -v -v: split flag matches -vv" {
	"$LSUSB_BUILT" -vv   > "$TEST_TMP.joined" 2> /dev/null
	"$LSUSB_BUILT" -v -v > "$TEST_TMP.split"  2> /dev/null
	diff -u "$TEST_TMP.joined" "$TEST_TMP.split"
}
