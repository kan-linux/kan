# SPDX-FileCopyrightText: 2026 Greg Kroah-Hartman <gregkh@linuxfoundation.org>
#
# SPDX-License-Identifier: GPL-2.0-only
#
# The combination the --help text recommends.

setup() {
	: "${LSUSB_PY_BUILT:=$DIR/../lsusb.py}"
	: "${LSUSB_PY_INSTALLED:=$(command -v lsusb.py || true)}"
}

@test "lsusb.py -ciu: built and installed output is identical" {
	[ -n "$LSUSB_PY_INSTALLED" ]
	"$LSUSB_PY_BUILT"     -ciu > "$TEST_TMP.built"     2>&1
	"$LSUSB_PY_INSTALLED" -ciu > "$TEST_TMP.installed" 2>&1
	diff -u "$TEST_TMP.installed" "$TEST_TMP.built"
}

@test "lsusb.py -c -i -u: split flags match -ciu" {
	"$LSUSB_PY_BUILT" -ciu     > "$TEST_TMP.joined" 2>&1
	"$LSUSB_PY_BUILT" -c -i -u > "$TEST_TMP.split"  2>&1
	diff -u "$TEST_TMP.joined" "$TEST_TMP.split"
}

@test "lsusb.py --color --interfaces --hide-empty-hubs: matches -ciu" {
	"$LSUSB_PY_BUILT" -ciu                                      > "$TEST_TMP.short" 2>&1
	"$LSUSB_PY_BUILT" --color --interfaces --hide-empty-hubs    > "$TEST_TMP.long"  2>&1
	diff -u "$TEST_TMP.short" "$TEST_TMP.long"
}
