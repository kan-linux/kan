#!/bin/sh
# SPDX-FileCopyrightText: 2026 Greg Kroah-Hartman <gregkh@linuxfoundation.org>
#
# SPDX-License-Identifier: GPL-2.0-only
#
# -i 255 matches any interface number, so this exercises the option
# parser without needing to know the HID interface layout.

setup() {
	: "${USBHID_DUMP_BUILT:=$DIR/../build/usbhid-dump}"
	: "${USBHID_DUMP_INSTALLED:=$(command -v usbhid-dump || true)}"
}

nots() {
	sed 's/ *[0-9][0-9]*\.[0-9][0-9]*$//'
}

@test "usbhid-dump -i N: built and installed output is identical" {
	[ -n "$USBHID_DUMP_INSTALLED" ]
	"$USBHID_DUMP_BUILT"     -i 255 2>&1 | nots > "$TEST_TMP.built"
	"$USBHID_DUMP_INSTALLED" -i 255 2>&1 | nots > "$TEST_TMP.installed"
	diff -u "$TEST_TMP.installed" "$TEST_TMP.built"
}

@test "usbhid-dump --interface: long option matches -i" {
	"$USBHID_DUMP_BUILT" -i 255          2>&1 | nots > "$TEST_TMP.short"
	"$USBHID_DUMP_BUILT" --interface=255 2>&1 | nots > "$TEST_TMP.long"
	diff -u "$TEST_TMP.short" "$TEST_TMP.long"
}
