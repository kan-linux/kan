#!/bin/sh
# SPDX-FileCopyrightText: 2026 Greg Kroah-Hartman <gregkh@linuxfoundation.org>
#
# SPDX-License-Identifier: GPL-2.0-only
#
# -f usb.ids path combined with display options.

setup() {
	: "${LSUSB_PY_BUILT:=$DIR/../lsusb.py}"
	: "${LSUSB_PY_INSTALLED:=$(command -v lsusb.py || true)}"
	for ids in /usr/share/hwdata/usb.ids /usr/share/usb.ids; do
		[ -r "$ids" ] && break
	done
	[ -r "$ids" ]
}

@test "lsusb.py -Cie -f path: built and installed output is identical" {
	[ -n "$LSUSB_PY_INSTALLED" ]
	"$LSUSB_PY_BUILT"     -Cie -f "$ids" > "$TEST_TMP.built"     2>&1
	"$LSUSB_PY_INSTALLED" -Cie -f "$ids" > "$TEST_TMP.installed" 2>&1
	diff -u "$TEST_TMP.installed" "$TEST_TMP.built"
}

@test "lsusb.py -f path -CIew: built and installed output is identical" {
	[ -n "$LSUSB_PY_INSTALLED" ]
	"$LSUSB_PY_BUILT"     -f "$ids" -CIew > "$TEST_TMP.built"     2>&1
	"$LSUSB_PY_INSTALLED" -f "$ids" -CIew > "$TEST_TMP.installed" 2>&1
	diff -u "$TEST_TMP.installed" "$TEST_TMP.built"
}

@test "lsusb.py -f /dev/null -Ci: empty usb.ids, both agree" {
	[ -n "$LSUSB_PY_INSTALLED" ]
	"$LSUSB_PY_BUILT"     -f /dev/null -Ci > "$TEST_TMP.built"     2>&1
	"$LSUSB_PY_INSTALLED" -f /dev/null -Ci > "$TEST_TMP.installed" 2>&1
	diff -u "$TEST_TMP.installed" "$TEST_TMP.built"
}
