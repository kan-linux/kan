#!/bin/sh
# SPDX-FileCopyrightText: 2026 Greg Kroah-Hartman <gregkh@linuxfoundation.org>
#
# SPDX-License-Identifier: GPL-2.0-only
#
# -s 0:0 matches any bus/device, so this exercises the option parser
# without needing to know which attached device is HID.

setup() {
	: "${USBHID_DUMP_BUILT:=$DIR/../build/usbhid-dump}"
	: "${USBHID_DUMP_INSTALLED:=$(command -v usbhid-dump || true)}"
}

nots() {
	sed 's/ *[0-9][0-9]*\.[0-9][0-9]*$//'
}

@test "usbhid-dump -s bus:dev: built and installed output is identical" {
	[ -n "$USBHID_DUMP_INSTALLED" ]
	"$USBHID_DUMP_BUILT"     -s 0:0 2>&1 | nots > "$TEST_TMP.built"
	"$USBHID_DUMP_INSTALLED" -s 0:0 2>&1 | nots > "$TEST_TMP.installed"
	diff -u "$TEST_TMP.installed" "$TEST_TMP.built"
}

@test "usbhid-dump -a, --address: aliases match -s" {
	"$USBHID_DUMP_BUILT" -s 0:0        2>&1 | nots > "$TEST_TMP.s"
	"$USBHID_DUMP_BUILT" -a 0:0        2>&1 | nots > "$TEST_TMP.a"
	"$USBHID_DUMP_BUILT" --address=0:0 2>&1 | nots > "$TEST_TMP.long"
	diff -u "$TEST_TMP.s" "$TEST_TMP.a"
	diff -u "$TEST_TMP.s" "$TEST_TMP.long"
}
