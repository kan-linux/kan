#!/bin/sh
# SPDX-FileCopyrightText: 2026 Greg Kroah-Hartman <gregkh@linuxfoundation.org>
#
# SPDX-License-Identifier: GPL-2.0-only
#
# -c / -C override semantics, and that both binaries agree on them.

setup() {
	: "${LSUSB_PY_BUILT:=$DIR/../lsusb.py}"
	: "${LSUSB_PY_INSTALLED:=$(command -v lsusb.py || true)}"
}

@test "lsusb.py -cC: built and installed output is identical" {
	[ -n "$LSUSB_PY_INSTALLED" ]
	"$LSUSB_PY_BUILT"     -cC > "$TEST_TMP.built"     2>&1
	"$LSUSB_PY_INSTALLED" -cC > "$TEST_TMP.installed" 2>&1
	diff -u "$TEST_TMP.installed" "$TEST_TMP.built"
}

@test "lsusb.py -Cc: built and installed output is identical" {
	[ -n "$LSUSB_PY_INSTALLED" ]
	"$LSUSB_PY_BUILT"     -Cc > "$TEST_TMP.built"     2>&1
	"$LSUSB_PY_INSTALLED" -Cc > "$TEST_TMP.installed" 2>&1
	diff -u "$TEST_TMP.installed" "$TEST_TMP.built"
}
