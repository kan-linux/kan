#!/bin/sh
# SPDX-FileCopyrightText: 2026 Greg Kroah-Hartman <gregkh@linuxfoundation.org>
#
# SPDX-License-Identifier: GPL-2.0-only
#
# -D goes through dump_one_device() and never reaches list_devices(), so
# -s and -d are parsed but unused.

setup() {
	: "${LSUSB_BUILT:=$DIR/../build/lsusb}"
	: "${LSUSB_INSTALLED:=$(command -v lsusb || true)}"
	# "Bus 001 Device 001: ID 1d6b:0002 Linux Foundation ..."
	set -- $("$LSUSB_BUILT" | head -n1)
	[ $# -ge 4 ]
	devpath="/dev/bus/usb/$2/${4%:}"
	[ -e "$devpath" ]
}

@test "lsusb -D path -s 999:999: matches -D alone" {
	"$LSUSB_BUILT" -D "$devpath"            > "$TEST_TMP.bare" 2>&1
	"$LSUSB_BUILT" -D "$devpath" -s 999:999 > "$TEST_TMP.s"    2>&1
	diff -u "$TEST_TMP.bare" "$TEST_TMP.s"
}

@test "lsusb -D path -d ffff:ffff: matches -D alone" {
	"$LSUSB_BUILT" -D "$devpath"              > "$TEST_TMP.bare" 2>&1
	"$LSUSB_BUILT" -D "$devpath" -d ffff:ffff > "$TEST_TMP.d"    2>&1
	diff -u "$TEST_TMP.bare" "$TEST_TMP.d"
}

@test "lsusb -v -D path -s/-d: built and installed output is identical" {
	[ -n "$LSUSB_INSTALLED" ]
	"$LSUSB_BUILT"     -v -D "$devpath" -s 999:999 -d ffff:ffff > "$TEST_TMP.built"     2>&1
	"$LSUSB_INSTALLED" -v -D "$devpath" -s 999:999 -d ffff:ffff > "$TEST_TMP.installed" 2>&1
	diff -u "$TEST_TMP.installed" "$TEST_TMP.built"
}
