#!/bin/sh
# SPDX-FileCopyrightText: 2026 Greg Kroah-Hartman <gregkh@linuxfoundation.org>
#
# SPDX-License-Identifier: GPL-2.0-only
#
# Only -e descriptor is comparison-tested. -e stream / -e all capture
# live interrupt transfers and are non-deterministic, and -t/-p/-f only
# affect stream mode.

setup() {
	: "${USBHID_DUMP_BUILT:=$DIR/../build/usbhid-dump}"
	: "${USBHID_DUMP_INSTALLED:=$(command -v usbhid-dump || true)}"
}

nots() {
	sed 's/ *[0-9][0-9]*\.[0-9][0-9]*$//'
}

@test "usbhid-dump -e descriptor: built and installed output is identical" {
	[ -n "$USBHID_DUMP_INSTALLED" ]
	"$USBHID_DUMP_BUILT"     -e descriptor 2>&1 | nots > "$TEST_TMP.built"
	"$USBHID_DUMP_INSTALLED" -e descriptor 2>&1 | nots > "$TEST_TMP.installed"
	diff -u "$TEST_TMP.installed" "$TEST_TMP.built"
}

@test "usbhid-dump --entity: long option matches -e" {
	"$USBHID_DUMP_BUILT" -e descriptor       2>&1 | nots > "$TEST_TMP.short"
	"$USBHID_DUMP_BUILT" --entity=descriptor 2>&1 | nots > "$TEST_TMP.long"
	diff -u "$TEST_TMP.short" "$TEST_TMP.long"
}
