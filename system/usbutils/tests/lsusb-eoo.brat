#!/bin/sh
# SPDX-FileCopyrightText: 2026 Greg Kroah-Hartman <gregkh@linuxfoundation.org>
#
# SPDX-License-Identifier: GPL-2.0-only
#
# -- terminates option parsing; lsusb rejects positionals, so anything
# after -- is an error.  A bare -- with options before it should be a
# no-op.

setup() {
	: "${LSUSB_BUILT:=$DIR/../build/lsusb}"
	: "${LSUSB_INSTALLED:=$(command -v lsusb || true)}"
}

@test "lsusb -- -v: -v after -- is a positional, usage and exit 1" {
	run "$LSUSB_BUILT" -- -v
	[ $status -ne 0 ]
	match "$stderr" '/Usage: lsusb/'
}

@test "lsusb -v --: trailing -- is a no-op" {
	"$LSUSB_BUILT" -v    > "$TEST_TMP.bare" 2>&1
	"$LSUSB_BUILT" -v -- > "$TEST_TMP.eoo"  2>&1
	diff -u "$TEST_TMP.bare" "$TEST_TMP.eoo"
}

@test "lsusb -- -v: built and installed output is identical" {
	[ -n "$LSUSB_INSTALLED" ]
	"$LSUSB_BUILT"     -- -v > "$TEST_TMP.built"     2>&1 || true
	"$LSUSB_INSTALLED" -- -v > "$TEST_TMP.installed" 2>&1 || true
	diff -u "$TEST_TMP.installed" "$TEST_TMP.built"
}
