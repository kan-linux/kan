	@rm -f test_chkname$(EXEEXT)
	$(AM_V_CCLD)$(test_chkname_LINK) $(test_chkname_OBJECTS) $(test_chkname_LDADD) $(LIBS)

test_exit_if_null$(EXEEXT): $(test_exit_if_null_OBJECTS) $(test_exit_if_null_DEPENDENCIES) $(EXTRA_test_exit_if_null_DEPENDENCIES) 
	@rm -f test_exit_if_null$(EXEEXT)
	$(AM_V_CCLD)$(test_exit_if_null_LINK) $(test_exit_if_null_OBJECTS) $(test_exit_if_null_LDADD) $(LIBS)

test_logind$(EXEEXT): $(test_logind_OBJECTS) $(test_logind_DEPENDENCIES) $(EXTRA_test_logind_DEPENDENCIES) 
	@rm -f test_logind$(EXEEXT)
	$(AM_V_CCLD)$(test_logind_LINK) $(test_logind_OBJECTS) $(test_logind_LDADD) $(LIBS)

test_stprintf$(EXEEXT): $(test_stprintf_OBJECTS) $(test_stprintf_DEPENDENCIES) $(EXTRA_test_stprintf_DEPENDENCIES) 
