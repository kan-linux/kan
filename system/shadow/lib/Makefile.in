	-rm -rf alloc/.libs alloc/_libs
	-rm -rf atoi/.libs atoi/_libs
	-rm -rf atoi/strtoi/.libs atoi/strtoi/_libs
	-rm -rf fs/mkstemp/.libs fs/mkstemp/_libs
	-rm -rf fs/readlink/.libs fs/readlink/_libs
