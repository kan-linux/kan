#: find/exec.c:121
#, c-format
msgid "Failed to save working directory in order to run a command on %s"
msgstr "Falha ao gravar a pasta de trabalho para executar um comando em %s"

#: find/exec.c:241
#, c-format
msgid "Cannot close standard input"
msgstr "Impossível fechar a entrada padrão"

#: find/exec.c:273
#, c-format
msgid "Failed to change directory to %s"
msgstr "Impossível mudar a pasta para %s"

#: find/exec.c:277
#, c-format
msgid "Failed to change directory"
msgstr "Impossível mudar a pasta"

#. TRANSLATORS: fork is the name of a system call, and so it
#. * doesn't necessarily require a translation.  But to make the
#. * error message more easily understandable you might translate
#. * this message as something like "cannot create a new process
#. * because the system call 'fork' failed".
#.
#: find/exec.c:328 xargs/xargs.c:1370
#, c-format
msgid "cannot fork"
msgstr "impossível bifurcar"

#: find/exec.c:360
#, c-format
msgid "error waiting for the command we executed for %s"
msgstr "erro ao aguardar o comando executado para %s"

#: find/exec.c:369
#, c-format
msgid "%s terminated by signal %d"
msgstr "%s terminado pelo sinal %d"

#: find/fstype.c:236
#, c-format
msgid "Cannot read mounted file system list"
msgstr "Impossível ler lista de sistema de ficheiros montado"

#. TRANSLATORS: The "unknown" here is a placeholder for the type of
#. * a file system which we were not able to identify.  File system
#. * names are typically short, so something like "file system of
#. * unknown type" would be longer than ideal.
#.
#: find/fstype.c:271
msgid "unknown"
msgstr "desconhecido"

#: find/ftsfind.c:208
#, c-format
msgid ""
"Symbolic link %s is part of a loop in the directory hierarchy; we have "
"already visited the directory to which it points."
msgstr ""
"A ligação simbólica %s é parte de um ciclo na hierarquia de pastas; Já "
"visitámos a pasta para a qual ela aponta."

#: find/ftsfind.c:222
#, c-format
msgid ""
"File system loop detected; the following directory is part of the cycle: %s"
msgstr ""
"Ciclo de sistema de ficheiros detectado; a pasta seguinte é parte do ciclo: "
"%s"

#: find/ftsfind.c:374 find/util.c:261
#, c-format
msgid "WARNING: file %s appears to have mode 0000"
msgstr "AVISO: o ficheiro %s parece ter modo 0000"

#: find/ftsfind.c:492
#, c-format
msgid "cannot search %s"
msgstr "impossível procurar %s"

#: find/ftsfind.c:538
#, c-format
msgid "failed to restore working directory after searching %s"
msgstr "falha ao restaurar a pasta de trabalho após procurar %s"

#: find/ftsfind.c:565
#, c-format
msgid "extra operand %s"
msgstr "operando extra %s"

#: find/ftsfind.c:567
#, c-format
msgid "file operands cannot be combined with -files0-from"
msgstr "operandos de ficheiro não podem ser combinados com -files0-from"

#: find/ftsfind.c:578
#, c-format
msgid ""
"when -ok or -okdir is in use, the option -files0-from cannot also read from "
"standard input"
msgstr ""
"quando se utiliza -ok ou -okdir, a opção -files0-from não pode, "
"simultaneamente, ler a partir da entrada padrão"

#: find/ftsfind.c:580
msgid "(standard input)"
msgstr "(entrada padrão)"

#: find/ftsfind.c:589
#, c-format
msgid "cannot open %s for reading"
msgstr "impossível abrir %s para leitura"

#: find/ftsfind.c:609
#, c-format
msgid ""
"when -ok or -okdir is in use, the option -files0-from cannot also read from "
"standard input, but the file (%s) used for -files0-from appears to refer to "
"the same file as the standard input"
msgstr ""
"quando se utiliza -ok ou -okdir, a opção -files0-from não pode ler também a "
"partir da entrada padrão, mas o ficheiro (%s) utilizado para -files0-from "
"parece referir-se ao mesmo ficheiro que a entrada padrão"

#: find/ftsfind.c:651
#, c-format
msgid "%s: read error"
msgstr "%s: erro de leitura"

#: find/ftsfind.c:678
msgid "invalid zero-length file name"
msgstr "nome de ficheiro de tamanho zero inválido"

#: find/ftsfind.c:702
#, c-format
msgid "error reading %s"
msgstr "erro ao ler %s"

#: find/ftsfind.c:737
#, c-format
msgid "Failed to initialize shared-file hash table"
msgstr "Falha ao inicializar tabela de hash de ficheiro partilhado"

#: find/ftsfind.c:752 locate/frcode.c:218 locate/locate.c:1564
#: xargs/xargs.c:433
#, c-format
msgid "The atexit library function failed"
msgstr "Falha na função de biblioteca atexit"

#: find/parser.c:440
#, c-format
msgid ""
"The -delete action automatically turns on -depth, but -prune does nothing "
"when -depth is in effect.  If you want to carry on anyway, just explicitly "
"use the -depth option."
msgstr ""
"A acção -delete liga automaticamente -depth, mas -prune não tem efeito "
"quando -depth está activa. Se deseja prosseguir mesmo assim, use "
"explicitamente a opção -depth."

#: find/parser.c:598
#, c-format
msgid ""
"warning: you have specified the global option %s after the argument %s, but "
"global options are not positional, i.e., %s affects tests specified before "
"it as well as those specified after it.  Please specify global options "
"before other arguments."
msgstr ""
"aviso: especificou a opção global %s após o argumento %s, mas as opções "
"globais não são posicionais (i.e. %s afecta testes especificados antes, "
"assim como os especificados depois). Por favor, especifique as opções "
"globais antes de outros argumentos."

#: find/parser.c:658
#, c-format
msgid ""
"warning: operator '%s' (with leading dash '-') will no longer be accepted in "
"future findutils releases!"
msgstr ""
"aviso: o operador \"%s\" (com um traço inicial \"-\") deixará de ser aceite "
"nas futuras versões do findutils!"

#: find/parser.c:915
#, c-format
msgid ""
"warning: the -d option is deprecated; please use -depth instead, because the "
"latter is a POSIX-compliant feature."
msgstr ""
"aviso: a opção -d é obsoleta; por favor, use antes -depth, a última é uma "
"funcionalidade que cumpre a norma POSIX."

#: find/parser.c:1159
#, c-format
msgid "invalid group name or GID argument to -group: %s"
msgstr "nome de grupo ou argumento GID inválido na opção -group: %s"

#: find/parser.c:1232
#, c-format
msgid "basic correctness check of the fnmatch() library function failed."
msgstr ""
"a verificação básica de correcção da função de biblioteca fnmatch() falhou."

#: find/parser.c:1247
#, c-format
msgid ""
"warning: %s matches against basenames only, but the given pattern contains a "
"directory separator (%s), thus the expression will evaluate to false all the "
"time.  Did you mean %s?"
msgstr ""
"aviso: só há %s correspondências contra nomes-base, mas o padrão indicado "
"contém um separador de pasta (%s), a expressão vai devolver sempre falso. "
"Quereria dizer %s?"

#: find/parser.c:1361
#, c-format
msgid "Expected a positive decimal integer argument to %s, but got %s"
msgstr "Esperado um argumento inteiro decimal positivo para %s, obtido %s"

#: find/parser.c:1520
#, c-format
msgid "This system does not provide a way to find the birth time of a file."
msgstr ""
"Este sistema não fornece uma forma de encontrar a hora de nascimento de um "
"ficheiro."

#: find/parser.c:1541
#, c-format
msgid "The %s test needs to be followed by an argument"
msgstr "O teste %s tem de ser seguido de um argumento"

#: find/parser.c:1578
#, c-format
msgid "I cannot figure out how to interpret %s as a date or time"
msgstr "Impossível perceber como interpretar %s como data ou hora"

#: find/parser.c:1595
#, c-format
msgid "Cannot obtain birth time of file %s"
msgstr "Impossível obter hora de nascimento do ficheiro %s"

#. TRANSLATORS: the first argument here (-%s) expands to the a test
#. * which the user specified on the command line. The second is the
#. * argument they gave for it.   These might be, for example:
#. *
#. * warning: -ipath foo/ will not match anything...
#. * warning: -path z/q/ will not match anything...
#.
#: find/parser.c:1746
#, c-format
msgid "warning: -%s %s will not match anything because it ends with /."
msgstr "aviso: -%s %s não vai encontrar nada porque termina com /."

#. TRANSLATORS: "mode" here is used in the same sense as we use
#. * for the "chmod" program.
#.
#: find/parser.c:1845
#, c-format
msgid "invalid file mode %s"
msgstr "modo de ficheiro inválido %s"

#: find/parser.c:1864
#, c-format
msgid ""
"warning: you have specified a mode pattern %s (which is equivalent to /000). "
"The meaning of -perm /000 was changed in 2007 to be consistent with -perm "
"-000; that is, while it used to match no files, it now matches all files. "
"This warning message will be removed in a future findutils release."
msgstr ""
"aviso: especificou um padrão de modo %s (que é equivalente a /000). O "
"significado de -perm /000 foi alterado em 2007 para ser consistente com "
"-perm -000; ou seja, enquanto antes não correspondia a nenhum ficheiro, "
"agora corresponde a todos os ficheiros; esta mensagem de aviso será removida "
"numa futura versão do findutils."

#: find/parser.c:2039
#, c-format
msgid "failed to compile regular expression '%s': %s"
msgstr "falha ao compilar a expressão regular \"%s\": %s"

#: find/parser.c:2069
#, c-format
msgid "invalid null argument to -size"
msgstr "argumento nulo inválido para -size"

#: find/parser.c:2119
#, c-format
msgid "invalid -size type `%c'"
msgstr "tipo -size \"%c\" inválido"

#: find/parser.c:2129
#, c-format
msgid "Invalid argument `%s%s' to -size"
msgstr "Argumento \"%s%s\" para -size inválido"

#: find/parser.c:2378
#, c-format
msgid "Invalid argument %s to -used"
msgstr "Argumento %s para -used inválido"

#: find/parser.c:2411
#, c-format
msgid "invalid user name or UID argument to -user: %s"
msgstr "nome de utilizador ou argumento UID inválido para -user: %s"

#: find/parser.c:2433
#, c-format
msgid "Features enabled: "
msgstr "Funcionalidades activas: "

#: find/parser.c:2479
#, c-format
msgid "invalid predicate -context: SELinux is not enabled."
msgstr "predicado -context inválido: SELinux não activo."

#: find/parser.c:2547
#, c-format
msgid "Arguments to %s should contain at least one letter"
msgstr "Argumentos para %s devem conter pelo menos uma letra"

#: find/parser.c:2612
#, c-format
msgid ""
"%s %c is not supported because symbolic links are not supported on the "
"platform find was compiled on."
msgstr ""
"%s %c não é suportado porque as ligações simbólicas não são suportadas na "
"plataforma em que o find foi compilado."

#: find/parser.c:2624
#, c-format
msgid ""
"%s %c is not supported because FIFOs are not supported on the platform find "
"was compiled on."
msgstr ""
"%s %c não é suportado porque FIFOs não são suportados na plataforma em que o "
"find foi compilado."

#: find/parser.c:2636
#, c-format
msgid ""
"%s %c is not supported because named sockets are not supported on the "
"platform find was compiled on."
msgstr ""
"%s %c não é suportado porque sockets nomeadas não são suportadas na "
"plataforma em que o find foi compilado."

#: find/parser.c:2652
#, c-format
msgid ""
"%s %c is not supported because Solaris doors are not supported on the "
"platform find was compiled on."
msgstr ""
"%s %c não é suportado porque portas Solaris não são suportadas na plataforma "
"em que o find foi compilado."

#: find/parser.c:2660
#, c-format
msgid "Unknown argument to %s: %c"
msgstr "Argumento para %s desconhecido: %c"

#: find/parser.c:2668
#, c-format
msgid "Duplicate file type '%c' in the argument list to %s."
msgstr "Tipo de ficheiro \"%c\" duplicado na lista de argumentos para %s."

#: find/parser.c:2684
#, c-format
msgid "Must separate multiple arguments to %s using: ','"
msgstr "Tem de separar múltiplos argumentos para %s com: \",\""

#: find/parser.c:2693
#, c-format
msgid ""
"Last file type in list argument to %s is missing, i.e., list is ending on: "
"','"
msgstr ""
"Falta o último tipo de ficheiro na lista de argumentos para %s, i.e., a "
"lista termina com \",\""

#: find/parser.c:2752
#, c-format
msgid ""
"The current directory is included in the PATH environment variable, which is "
"insecure in combination with the %s action of find.  Please remove the "
"current directory from your $PATH (that is, remove \".\", doubled colons, or "
"leading or trailing colons)"
msgstr ""
"A pasta actual está incluída na variável de ambiente PATH, o que não é "
"seguro em combinação com a acção %s do find. Por favor, remova a pasta "
"actual do seu $PATH (ou seja, remova \".\", dois-pontos duplos ou dois-"
"pontos iniciais ou finais)"

#: find/parser.c:2764
#, c-format
msgid ""
"The relative path %s is included in the PATH environment variable, which is "
"insecure in combination with the %s action of find.  Please remove that "
"entry from $PATH"
msgstr ""
"O caminho relativo %s actual está incluído na variável de ambiente PATH, o "
"que não é seguro em combinação com a acção %s do find. Por favor, remova a "
"entrada do seu $PATH"

#: find/parser.c:2883
#, c-format
msgid ""
"You may not use {} within the utility name for -execdir and -okdir, because "
"this is a potential security problem."
msgstr ""
"Não pode usar {} dentro do nome do utilitário para -execdir e -okdir, é um "
"potencial risco de segurança."

#: find/parser.c:2909
#, c-format
msgid "Only one instance of {} is supported with -exec%s ... +"
msgstr "Só uma instância de {} é suportada com -exec%s ... +"

#: find/parser.c:2919
#, c-format
msgid "In %s the %s must appear by itself, but you specified %s"
msgstr "Em %s, %s tem de aparecer por si mesmo, mas especificou %s"

#: find/parser.c:2938
#, c-format
msgid "The environment is too large for exec()."
msgstr "O ambiente é muito grande para exec()."

#: find/parser.c:3048
#, c-format
msgid "invalid not-a-number argument: `%s'"
msgstr "argumento inválido (não é número): \"%s\""

#: find/parser.c:3113
#, c-format
msgid "arithmetic overflow while converting %s days to a number of seconds"
msgstr "transporte aritmético ao converter %s dias para um número de segundos"

#: find/parser.c:3137
#, c-format
msgid "arithmetic overflow when trying to calculate the end of today"
msgstr "transporte aritmético ao tentar calcular o fim do dia de hoje"

#: find/parser.c:3287
#, c-format
msgid "non-numeric argument to %s: %s"
msgstr "argumento não numérico para %s: %s"

#: find/parser.c:3306
msgid "standard error"
msgstr "erro padrão"

#: find/parser.c:3311
msgid "standard output"
msgstr "saída padrão"

#: find/pred.c:233
#, c-format
msgid "cannot delete %s"
msgstr "impossível eliminar %s"

#: find/pred.c:605
#, c-format
msgid "WARNING: cannot determine birth time of file %s"
msgstr "AVISO: impossível determinar hora de nascimento do ficheiro %s"

#: find/pred.c:653
#, c-format
msgid "< %s ... %s > ? "
msgstr "< %s ... %s >? "

#: find/pred.c:655
#, c-format
msgid "Failed to write prompt for -ok"
msgstr "Falha ao escrever confirmação para -ok"

#: find/pred.c:1131 find/print.c:1236
#, c-format
msgid "getfilecon failed: %s"
msgstr "getfilecon falhou: %s"

#: find/print.c:333
#, c-format
msgid "warning: escape `\\' followed by nothing at all"
msgstr "aviso: escape \"\\\" seguido de nada"

#: find/print.c:352
#, c-format
msgid "warning: unrecognized escape `\\%c'"
msgstr "aviso: escape \"\\%c\" não reconhecido"

#: find/print.c:372 find/print.c:1258
#, c-format
msgid "error: %s at end of format string"
msgstr "erro: %s no final de cadeia de formato"

#: find/print.c:396
#, c-format
msgid "error: the format directive `%%%c' is reserved for future use"
msgstr "erro: a directiva de formato \"%%%c\" está reservada para uso futuro"

#: find/print.c:404
#, c-format
msgid ""
"warning: format directive `%%%c' should be followed by another character"
msgstr ""
"aviso: a directiva de formato \"%%%c\" deve ser seguida de outro carácter"

#: find/print.c:412
#, c-format
msgid "warning: unrecognized format directive `%%%c'"
msgstr "aviso: directiva de formato \"%%%c\" não reconhecida"

#: find/tree.c:113 find/tree.c:118 find/tree.c:224 find/tree.c:263
#, c-format
msgid "invalid expression"
msgstr "expressão inválida"

#: find/tree.c:124
#, c-format
msgid ""
"invalid expression; you have used a binary operator '%s' with nothing before "
"it."
msgstr "expressão inválida: usou um operador binário \"%s\" sem nada antes."

#: find/tree.c:133 find/tree.c:192
#, c-format
msgid ""
"invalid expression: expected expression before closing parentheses '%s'."
msgstr "expressão inválida: esperada uma expressão antes de \"%s\"."

#: find/tree.c:143
#, c-format
msgid "expected an expression between '%s' and ')'"
msgstr "esperada uma expressão entre \"%s\" e \")\""

#: find/tree.c:153
#, c-format
msgid "expected an expression after '%s'"
msgstr "esperada uma expressão após \"%s\""

#: find/tree.c:158
#, c-format
msgid "invalid expression; you have too many ')'"
msgstr "expressão inválida: tem demasiados \")\""

#: find/tree.c:181
#, c-format
msgid ""
"invalid expression; expected to find a ')' but didn't see one. Perhaps you "
"need an extra predicate after '%s'"
msgstr ""
"expressão inválida: era esperado um \")\", mas não apareceu. Talvez precise "
"de um predicado extra após \"%s\""

#: find/tree.c:196
#, c-format
msgid "invalid expression; empty parentheses are not allowed."
msgstr "expressão inválida: não são permitidos parênteses vazios."

#: find/tree.c:202
#, c-format
msgid ""
"invalid expression; I was expecting to find a ')' somewhere but did not see "
"one."
msgstr "expressão inválida: era esperado um \")\" algures."

#: find/tree.c:209
#, c-format
msgid "oops -- invalid expression type! This is probably a bug."
msgstr "oops -- Tipo de expressão inválido! Provavelmente trata-se de um erro."

#: find/tree.c:281
#, c-format
msgid "oops -- invalid expression type (%d)!  This is probably a bug."
msgstr ""
"oops -- Tipo de expressão inválido (%d)! Provavelmente trata-se de um erro."

#: find/tree.c:837
#, c-format
msgid "oops -- invalid expression type!  This is probably a bug."
msgstr "oops -- Tipo de expressão inválido! Provavelmente trata-se de um erro."

#: find/tree.c:1092
#, c-format
msgid "failed to sort the costlookup array"
msgstr "impossível ordenar a matriz \"costlookup\""

#: find/tree.c:1114
#, c-format
msgid ""
"warning: there is no entry in the predicate evaluation cost table for "
"predicate %s; please report this as a bug"
msgstr ""
"aviso: não há entrada na tabela de avaliação de custos de predicados para o "
"predicado %s; por favor, reporte isto como erro"

#: find/tree.c:1288
#, c-format
msgid "paths must precede expression: `%s'"
msgstr "a expressão tem de ser precedida de caminhos: \"%s\""

#: find/tree.c:1290
#, c-format
msgid "possible unquoted pattern after predicate `%s'?"
msgstr "possível padrão sem aspas após predicado \"%s\"?"

#: find/tree.c:1300
#, c-format
msgid "unknown predicate `%s'"
msgstr "predicado \"%s\" desconhecido"

#: find/tree.c:1320
#, c-format
msgid "invalid predicate `%s'"
msgstr "predicado \"%s\" inválido"

#: find/tree.c:1324
#, c-format
msgid "invalid argument `%s' to `%s'"
msgstr "argumento \"%s\" inválido para \"%s\""

#: find/tree.c:1331
#, c-format
msgid "missing argument to `%s'"
msgstr "argumento par \"%s\" em falta"

#: find/tree.c:1407
#, c-format
msgid "you have too many ')'"
msgstr "tem demasiados \")\""

#: find/tree.c:1413
#, c-format
msgid "unexpected extra predicate '%s'"
msgstr "predicado extra \"%s\" inesperado"

#: find/tree.c:1415
#, c-format
msgid "unexpected extra predicate"
msgstr "predicado extra inesperado"

#: find/tree.c:1538
#, c-format
msgid "oops -- invalid default insertion of and!  This is probably a bug."
msgstr ""
"oops... Inserção predefinida inválida de and! Provavelmente trata-se de um "
"erro."

#: find/util.c:137
msgid "Valid arguments for -D:\n"
msgstr "Argumentos válidos para -D:\n"

#: find/util.c:161 locate/frcode.c:138 locate/locate.c:1361 xargs/xargs.c:1767
#, c-format
msgid "Try '%s --help' for more information.\n"
msgstr "Tente \"%s --help\" para mais informação.\n"

#: find/util.c:167
#, c-format
msgid ""
"Usage: %s [-H] [-L] [-P] [-Olevel] [-D debugopts] [path...] [expression]\n"
msgstr ""
"Uso: %s [-H] [-L] [-P] [-Olevel] [-D debugopts] [caminho...] [expressão]\n"

#: find/util.c:171
msgid ""
"\n"
"Default path is the current directory; default expression is -print.\n"
"Expression may consist of: operators, options, tests, and actions.\n"
msgstr ""
"\n"
"O caminho pré-definido é a pasta actual; a expressão pré-definida é -print.\n"
"A expressão pode consistir em: operadores, opções, testes e acções.\n"

#: find/util.c:174
msgid ""
"\n"
"Operators (decreasing precedence; -and is implicit where no others are "
"given):\n"
"      ( EXPR )   ! EXPR   -not EXPR   EXPR1 -a EXPR2   EXPR1 -and EXPR2\n"
"      EXPR1 -o EXPR2   EXPR1 -or EXPR2   EXPR1 , EXPR2\n"
msgstr ""
"\n"
"Operadores (precedência decrescente; -and é implícito onde nenhum outro for "
"dado):\n"
"      ( EXPR )   ! EXPR   -not EXPR   EXPR1 -a EXPR2   EXPR1 -and EXPR2\n"
"      EXPR1 -o EXPR2   EXPR1 -or EXPR2   EXPR1 , EXPR2\n"

#: find/util.c:178
msgid ""
"\n"
"Positional options (always true):\n"
"      -daystart -follow -nowarn -regextype -warn\n"
msgstr ""
"\n"
"Opções posicionais (sempre verdadeiro):\n"
"      -daystart -follow -nowarn -regextype -warn\n"

#: find/util.c:181
msgid ""
"\n"
"Normal options (always true, specified before other expressions):\n"
"      -depth -files0-from FILE -maxdepth LEVELS -mindepth LEVELS\n"
"      -mount -noleaf -xdev -ignore_readdir_race -noignore_readdir_race\n"
msgstr ""
"\n"
"Opções normais (sempre verdadeiras, especificadas antes de outras "
"expressões):\n"
"      -depth -files0-from FICH -maxdepth NÍVEIS -mindepth NÍVEIS\n"
