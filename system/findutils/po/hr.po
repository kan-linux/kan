#~ msgid ""
#~ "option -files0-from reading from standard input cannot be combined with "
#~ "-ok, -okdir"
#~ msgstr ""
#~ "opcija '-files0-from' koja čita sa standardnog ulaza ne može se "
#~ "kombinirati s '-ok', '-okdir'"

