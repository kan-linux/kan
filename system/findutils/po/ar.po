#~ "option -files0-from: standard input must not refer to the same file when "
#~ "combined with -ok, -okdir"
#~ msgstr ""
#~ "الخيار -files0-from: يجب ألا تشير المدخلات القياسية إلى نفس الملف عند "
#~ "دمجها مع -ok أو -okdir"

