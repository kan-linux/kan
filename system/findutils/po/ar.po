#~ msgid ""
#~ "read returned unexpected value %<PRIuMAX>; this is probably a bug, please "
#~ "report it"
#~ msgstr ""
#~ "أعادت القراءة قيمة غير متوقعة %<PRIuMAX>؛ ربما هذا خلل، يرجى الإبلاغ عنه"
